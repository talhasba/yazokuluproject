(function(){let bachelorSelect=document.querySelector('select[name="i_am_interested_in_bachelor"]');let masterSelect=document.querySelector('select[name="i_am_interested_in_master"]');if(bachelorSelect!==null)bachelorSelect.setAttribute('required','true');if(masterSelect!==null)masterSelect.setAttribute('required','true');if(bachelorSelect!==null)if(masterSelect!==null){bachelorSelect.addEventListener('change',function(){masterSelect.setAttribute('name','i_am_interested_in_master');masterSelect.removeAttribute('required');this.setAttribute('name','i_am_interested_in');this.setAttribute('required','required');});masterSelect.addEventListener('change',function(){bachelorSelect.setAttribute('name','i_am_interested_in_bachelor');bachelorSelect.removeAttribute('required');this.setAttribute('name','i_am_interested_in');this.setAttribute('required','required');});}})();;
(function($,Drupal,once){Drupal.behaviors.ckiGreenhouse={attach:function(context,settings){const greenhouseBoardToken="constructorknowledg";const apiUrl=`https://boards-api.greenhouse.io/v1/boards/${greenhouseBoardToken}/jobs`;fetch(apiUrl).then((response)=>{if(!response.ok)throw new Error("API request failed");return response.json();}).then((data)=>{const jobsList=document.getElementById("common-vacancies-list");if(!jobsList)return;if(!data.jobs||data.jobs.length===0){jobsList.innerHTML="<li>"+Drupal.t('No job openings available.')+"</li>";return;}jobsList.innerHTML=data.jobs.map((job)=>`
                        <li class="job-item">
                            <a href="${job.absolute_url}" target="_blank">${job.title}</a>
                            <br><small>${job.location.name}</small>
                        </li>
                    `).join("");}).catch((error)=>{console.error("API Error:",error);document.getElementById("common-vacancies-list").innerHTML="<li>"+Drupal.t('Failed to load job listings.')+"</li>";});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.trackingParameters={attach:function(context,settings){const COOKIE_NAME='eduengage_AdConnect';const COOKIE_EXPIRE_DAYS=730;const FIRST_UTM_KEYS=['utm_source','utm_medium','utm_campaign','utm_content','utm_term'];const LAST_KEYS=['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','fbclid','ttclid','msclkid','li_fat_id','campaign_id','campaign_name','ad_group_id','ad_group_name','ad_id','ad_name','creative_id','creative_name','keyword','matchtype','network','device','device_model','extension','free_item_id','placement','target','interest_location','location','site_source_name'];const FIELD_MAPPINGS={first_utm_source:'eduengage_first_utm_source',first_utm_medium:'eduengage_first_utm_medium',first_utm_campaign:'eduengage_first_utm_campaign',first_utm_content:'eduengage_first_utm_content',first_utm_term:'eduengage_first_utm_term',last_utm_source:'eduengage_last_utm_source',last_utm_medium:'eduengage_last_utm_medium',last_utm_campaign:'eduengage_last_utm_campaign',last_utm_content:'eduengage_last_utm_content',last_utm_term:'eduengage_last_utm_term',gclid:'gclid',fbclid:'fbclid',ttclid:'ttclid',msclkid:'msclkid',li_fat_id:'li_fat_id',last_campaign_id:'eduengage_campaign_id',last_campaign_name:'eduengage_campaign_name',last_ad_group_id:'eduengage_ad_group_id',last_ad_group_name:'eduengage_ad_group_name',last_ad_id:'eduengage_ad_id',last_ad_name:'eduengage_ad_name',last_creative_id:'eduengage_creative_id',last_creative_name:'eduengage_creative_name',last_keyword:'eduengage_keyword',last_matchtype:'eduengage_matchtype',last_network:'eduengage_network',last_device:'eduengage_device',last_device_model:'eduengage_device_model',last_extension:'eduengage_extension',last_free_item_id:'eduengage_free_item_id',last_placement:'eduengage_placement',last_target:'eduengage_target',last_interest_location:'eduengage_interest_location',last_location:'eduengage_location',last_site_source_name:'eduengage_site_source_name'};function setCookie(name,value,days){const expires=new Date(Date.now()+days*864e5).toUTCString();document.cookie=`${name}=${encodeURIComponent(value)}; expires=${expires}; path=/; secure; SameSite=Lax`;}function getCookie(name){const match=document.cookie.match(new RegExp('(^| )'+name+'=([^;]+)'));return match?decodeURIComponent(match[2]):null;}function getUrlParams(){const params={};new URLSearchParams(window.location.search).forEach((val,key)=>{if(val)params[key]=val;});return params;}function parseTrackingCookie(){try{return JSON.parse(getCookie(COOKIE_NAME)||'{}');}catch(e){console.warn('Error parsing cookie:',e);return {};}}function buildTrackingCookie(existing,urlParams){const result={...existing};for(const key of FIRST_UTM_KEYS){const urlVal=urlParams[key];if(!result[`first_${key}`]&&urlVal)result[`first_${key}`]=urlVal;}for(const key of [...FIRST_UTM_KEYS,...LAST_KEYS]){const urlVal=urlParams[key];if(urlVal)result[`last_${key}`]=urlVal;}return result;}function populateFormFields(trackingData){for(const key in trackingData){const fieldClass=FIELD_MAPPINGS[key];if(!fieldClass)continue;const selector=`.webform-submission-form [name="${fieldClass}"]`;try{const field=document.querySelector(selector);if(field)field.value=trackingData[key];}catch(e){console.warn(`Field not found for selector: ${selector}`);}}}window.addEventListener('load',function(){const urlParams=getUrlParams();const existing=parseTrackingCookie();const updated=buildTrackingCookie(existing,urlParams);setCookie(COOKIE_NAME,JSON.stringify(updated),COOKIE_EXPIRE_DAYS);populateFormFields(updated);});}};})(jQuery,Drupal,once);;
(function($,Drupal,once){Drupal.behaviors.secondaryNavigation={attach:function(context,settings){const header=document.querySelector('.dialog-off-canvas-main-canvas > header');const navBlock=document.querySelector('#block-views-block-navigation-block-1');if(!header)return;if(!navBlock)return;const isMobile=window.innerWidth<992;const TRANSLATE_Y=isMobile?62:70;let SCROLL_TRIGGER=navBlock.getBoundingClientRect().top+window.scrollY-navBlock.offsetHeight;window.addEventListener('resize',()=>{SCROLL_TRIGGER=navBlock.getBoundingClientRect().top+window.scrollY-navBlock.offsetHeight;});let lastScrollY=window.scrollY;let isFixed=false;let headerHidden=false;let currentScrollPosition=window.pageYOffset||document.documentElement.scrollTop||document.body.scrollTop||0;function applyFixedStyles(){header.style.position='fixed';header.style.top='0';header.style.left='0';header.style.right='0';header.style.zIndex='101';header.style.width='100%';header.style.transition='transform 0.3s ease';header.style.willChange='transform';header.style.transform=`translateY(-${TRANSLATE_Y}px)`;navBlock.style.position='fixed';navBlock.style.top='0';navBlock.style.left='0';navBlock.style.right='0';navBlock.style.zIndex='99';navBlock.style.width='100%';navBlock.style.transition='transform 0.3s ease';navBlock.style.willChange='transform';navBlock.style.transform='translateY(0)';navBlock.classList.add('is-fixed');setTimeout(()=>{if(window.reinitEmblaInstances)window.reinitEmblaInstances();},100);}function resetStyles(){header.removeAttribute('style');navBlock.removeAttribute('style');navBlock.classList.remove('is-fixed');setTimeout(()=>{if(window.reinitEmblaInstances)window.reinitEmblaInstances();},100);}const megaMenu=document.querySelector('.mega-menu-wrapper');let savedScrollPosition=0;let savedIsFixed=false;let savedHeaderHidden=false;if(megaMenu){const observer=new MutationObserver((mutations)=>{mutations.forEach((mutation)=>{if(mutation.type==='attributes'&&mutation.attributeName==='class')if(megaMenu.classList.contains('open')){savedScrollPosition=currentScrollPosition;savedIsFixed=isFixed;savedHeaderHidden=headerHidden;document.body.style.position='fixed';document.body.style.top=`-${savedScrollPosition}px`;document.body.style.width='100%';header.removeAttribute('style');navBlock.removeAttribute('style');navBlock.classList.remove('is-fixed');isFixed=false;headerHidden=false;}else{document.body.style.position='';document.body.style.top='';document.body.style.width='';requestAnimationFrame(()=>{const htmlEl=document.documentElement;const originalBehavior=htmlEl.style.scrollBehavior;htmlEl.style.scrollBehavior='auto';window.scrollTo(0,savedScrollPosition);document.documentElement.scrollTop=savedScrollPosition;document.body.scrollTop=savedScrollPosition;isFixed=savedIsFixed;headerHidden=savedHeaderHidden;if(savedIsFixed){applyFixedStyles();if(savedHeaderHidden){header.style.transform=`translateY(-${TRANSLATE_Y}px)`;navBlock.style.transform='translateY(0)';}else{header.style.transform='translateY(0)';navBlock.style.transform=`translateY(${TRANSLATE_Y}px)`;}}setTimeout(()=>{htmlEl.style.scrollBehavior=originalBehavior;},0);setTimeout(()=>{if(window.reinitEmblaInstances)window.reinitEmblaInstances();},100);});}});});observer.observe(megaMenu,{attributes:true});}function handleScroll(){if(megaMenu&&megaMenu.classList.contains('open'))return;const currentScrollY=window.scrollY;currentScrollPosition=window.pageYOffset||document.documentElement.scrollTop||document.body.scrollTop||0;const scrollingDown=currentScrollY>lastScrollY;const scrollingUp=currentScrollY<lastScrollY;const isMobileScreen=window.innerWidth<992;if(currentScrollY>=SCROLL_TRIGGER)if(!isFixed){applyFixedStyles();isFixed=true;headerHidden=false;}else if(scrollingUp&&headerHidden){header.style.transform='translateY(0)';navBlock.style.transform=`translateY(${TRANSLATE_Y}px)`;headerHidden=false;}else{if(scrollingDown&&!headerHidden){header.style.transform=`translateY(-${TRANSLATE_Y}px)`;navBlock.style.transform='translateY(0)';headerHidden=true;}}else{if(isFixed){resetStyles();isFixed=false;headerHidden=false;}}lastScrollY=currentScrollY;}window.addEventListener('scroll',handleScroll);}};})(jQuery,Drupal,once);;
(function(Drupal){Drupal.behaviors.shortsVideo={initialize:function(short){const preview=short.querySelector('.video-preview'),video=short.querySelector('video'),videoIframe=short.querySelector('iframe');function play(){short.classList.add('active');if(video)video.play();else{if(videoIframe){const youtube=videoIframe.contentWindow.document.querySelector('iframe');let videoUrl=youtube.src;if(videoUrl.indexOf('?')!=-1)videoUrl=videoUrl+'&autoplay=1';else videoUrl=videoUrl+'?autoplay=1';youtube.src=videoUrl;}}}preview.addEventListener('click',play);},attach:function(context){context.querySelectorAll('.media-shorts').forEach((short)=>{if(!short.dataset.initialized){short.dataset.initialized='true';Drupal.behaviors.shortsVideo.initialize(short);}});}};})(Drupal);;
