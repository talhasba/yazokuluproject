class ConMegaMenu{constructor(menu){this.menu=menu;this.megaMenuWrapper=menu.closest('.mega-menu-wrapper');this.isMobile=this.isMobileView();this.menuLinks=menu.querySelectorAll('.tbm-item .tbm-link');this.currentListeners=[];this.quickLinks=document.getElementById('block-constructor-quicklinks');this.langSwitcher=this.megaMenuWrapper.querySelector('.language-switcher-language-url');this.previousMobileState=this.isMobile;this.toggler=document.querySelector('.navbar-toggler-svg');this.searchLink=document.querySelector('.block-search-icon-block .search-link');this.searchForm=document.querySelector('.block-search-icon-block .header-search-form');this.initToggler();this.initSearch();this.bindKeyboardEvents();}init=()=>{this.clearListeners();this.clearOpenClasses();if(this.isMobile){this.initMobileListeners();if(this.quickLinks)this.initQuickLinks();if(this.langSwitcher)this.initLangSwitcher();}else this.initDesktopListeners();};initToggler=()=>{if(this.toggler){const toggleHandler=()=>{this.toggler.classList.remove('active','closing');if(this.megaMenuWrapper.classList.contains('open')){document.body.classList.remove('mega-menu-opened');document.documentElement.style.removeProperty('--megamenu-scrollbar-width');this.clearOpenClasses();if(this.quickLinks)this.quickLinks.classList.remove('hidden');if(this.langSwitcher)this.langSwitcher.classList.remove('hidden');this.toggler.classList.add('closing');}else{const scrollbarWidth=window.innerWidth-document.documentElement.clientWidth;document.documentElement.style.setProperty('--megamenu-scrollbar-width',scrollbarWidth+'px');document.body.classList.add('mega-menu-opened');if(!this.isMobile)this.openInitialSubmenus();if(this.searchLink){this.searchLink.classList.remove('active');this.searchForm.classList.remove('active');}this.toggler.classList.add('active');}this.megaMenuWrapper.classList.toggle('open');};this.toggler.addEventListener('click',toggleHandler);}};initSearch=()=>{if(this.searchLink){const searchLinkHandler=()=>{if(!this.searchLink.classList.contains('active')){document.body.classList.remove('mega-menu-opened');document.documentElement.style.removeProperty('--megamenu-scrollbar-width');}else{const scrollbarWidth=window.innerWidth-document.documentElement.clientWidth;document.documentElement.style.setProperty('--megamenu-scrollbar-width',scrollbarWidth+'px');document.body.classList.add('mega-menu-opened');}this.megaMenuWrapper.classList.remove('open');this.toggler.classList.remove('active','closing');this.toggler.classList.add('closing');this.clearOpenClasses();};this.searchLink.addEventListener('click',searchLinkHandler);}};bindKeyboardEvents=()=>{const keyHandler=(event)=>{if(event.key==="Escape"||event.keyCode===27)if(this.megaMenuWrapper.classList.contains('open')){document.body.classList.remove('mega-menu-opened');document.documentElement.style.removeProperty('--megamenu-scrollbar-width');this.megaMenuWrapper.classList.remove('open');this.toggler.classList.remove('active','closing');this.toggler.classList.add('closing');this.clearOpenClasses();}};document.addEventListener('keydown',keyHandler);};initMobileListeners=()=>{this.menuLinks.forEach((item)=>{const clickHandler=(event)=>this.toggleSubMenu(event.target);const keydownHandler=(event)=>{if(event.key==='Enter'||event.keyCode===13)this.toggleSubMenu(event.target);};item.addEventListener('click',clickHandler);item.addEventListener('keydown',keydownHandler);this.currentListeners.push({element:item,type:'click',handler:clickHandler});this.currentListeners.push({element:item,type:'keydown',handler:keydownHandler});});};initDesktopListeners=()=>{this.menuLinks.forEach((item)=>{if(item.classList.contains('level-1')||item.classList.contains('level-2')){const clickHandler=(event)=>{let subMenu=item.nextElementSibling;if(subMenu&&subMenu.classList.contains('tbm-item-child')){event.preventDefault();this.toggleSubMenu(item);this.addActiveClass(item);this.closeSiblings(item);}};item.addEventListener('click',clickHandler);this.currentListeners.push({element:item,type:'click',handler:clickHandler});}});};addActiveClass=(item)=>{this.removeActiveClassFromSiblings(item);item.classList.add('active');};removeActiveClassFromSiblings=(item)=>{const levelClass=item.classList.contains('level-1')?'level-1':'level-2';const siblingItems=Array.from(this.menu.getElementsByClassName(levelClass));siblingItems.forEach((sibling)=>{sibling.classList.remove('active');});};closeSiblings=(item)=>{const levelClass=item.classList.contains('level-1')?'level-1':'level-2';const siblingItems=Array.from(this.menu.getElementsByClassName(levelClass));siblingItems.forEach((sibling)=>{if(sibling!==item){let subMenu=sibling.nextElementSibling;if(subMenu&&subMenu.classList.contains('tbm-item-child'))subMenu.classList.remove('open');}});};clearListeners=()=>{this.currentListeners.forEach(({element,type,handler})=>{element.removeEventListener(type,handler);});this.currentListeners=[];};clearOpenClasses=()=>{this.menu.querySelectorAll('.open').forEach((el)=>el.classList.remove('open'));this.menu.querySelectorAll('.active').forEach((el)=>el.classList.remove('active'));};toggleSubMenu=(item)=>{let subMenu=item.nextElementSibling;if(subMenu&&subMenu.classList.contains('tbm-item-child')){subMenu.classList.toggle('open');item.classList.toggle('active');if(this.isMobile)if(subMenu.classList.contains('open')){if(this.quickLinks)this.quickLinks.classList.add('hidden');if(this.langSwitcher)this.langSwitcher.classList.add('hidden');}else{if(!this.menu.querySelector('.tbm-item-child.open')){if(this.quickLinks)this.quickLinks.classList.remove('hidden');if(this.langSwitcher)this.langSwitcher.classList.remove('hidden');}}}else{if(item.classList.contains('back-link')){let parentSubMenu=item.closest('.tbm-item-child');if(parentSubMenu){parentSubMenu.classList.remove('open');parentSubMenu.previousElementSibling.classList.remove('active');if(this.isMobile&&!this.menu.querySelector('.tbm-item-child.open')){if(this.quickLinks)this.quickLinks.classList.remove('hidden');if(this.langSwitcher)this.langSwitcher.classList.remove('hidden');}}}}};initQuickLinks=()=>{const title=this.quickLinks.querySelector('h5');if(title){if(this.quickLinks.classList.contains('hidden'))this.quickLinks.classList.remove('hidden');const clickHandler=()=>{if(this.langSwitcher&&this.langSwitcher.classList.contains('open'))this.langSwitcher.classList.remove('open');this.quickLinks.classList.toggle('open');};title.addEventListener('click',clickHandler);this.currentListeners.push({element:title,type:'click',handler:clickHandler});}};initLangSwitcher=()=>{const title=this.langSwitcher.querySelector('h5');if(title){if(this.langSwitcher.classList.contains('hidden'))this.langSwitcher.classList.remove('hidden');const clickHandler=()=>{if(this.quickLinks&&this.quickLinks.classList.contains('open'))this.quickLinks.classList.remove('open');this.langSwitcher.classList.toggle('open');};title.addEventListener('click',clickHandler);this.currentListeners.push({element:title,type:'click',handler:clickHandler});}};isMobileView=()=>window.matchMedia('(max-width: 1200px)').matches;handleResize=()=>{const currentMobileState=this.isMobileView();if(currentMobileState!==this.previousMobileState){this.isMobile=currentMobileState;this.previousMobileState=this.isMobile;this.init();}};debounce=(fn,ms=300)=>{let timeoutId;return (...args)=>{clearTimeout(timeoutId);timeoutId=setTimeout(()=>fn.apply(this,args),ms);};};openInitialSubmenus=()=>{const firstLevelItems=this.menu.querySelectorAll('.level-1.tbm-link');if(firstLevelItems.length>0){const firstLevelItem=firstLevelItems[0];this.toggleSubMenu(firstLevelItem);const secondLevelItems=firstLevelItem.parentElement.querySelectorAll('.level-2.tbm-link');if(secondLevelItems.length>0){const secondLevelItem=secondLevelItems[0];this.toggleSubMenu(secondLevelItem);}}};}(function($,Drupal){Drupal.behaviors.megaMenu={attach:function(context){context.querySelectorAll('ul.tbm-nav').forEach((menu)=>{if(!menu.dataset.initialized){menu.dataset.initialized='true';const megaMenu=new ConMegaMenu(menu);megaMenu.init();window.addEventListener('resize',megaMenu.debounce(megaMenu.handleResize),{passive:true});}});if(window.devicePixelRatio==1.25)$('body').addClass('scaled-x');if(window.devicePixelRatio==1.5)$('body').addClass('scaled-xl');}};})(jQuery,Drupal);;
